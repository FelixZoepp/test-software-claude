# N8N Konfiguration
N8N_BASE_URL=https://your-n8n-instance.com
N8N_API_KEY=your-n8n-api-key

# Webflow Konfiguration
WEBFLOW_API_TOKEN=your-webflow-api-token
WEBFLOW_SITE_ID=your-webflow-site-id
WEBFLOW_COLLECTION_ID=your-collection-id

# E-Mail Konfiguration (für Lead-Weiterleitung)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
NOTIFICATION_EMAIL=kunde@example.com

# Webhook Konfiguration
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_BASE_URL=https://your-domain.com/webhooks

# Datei-Download Konfiguration
DOWNLOAD_FILE_PATH=./assets/downloads
MAX_FILE_SIZE_MB=10
